{
  "manifest_version": 3,
  "name": "42 Reset — Débloquer l’Intra",
  "version": "1.1.1",
  "description": "Un clic pour effacer les cookies et le cache de l’Intra 42, puis rouvrir ses pages.",
  "minimum_chrome_version": "132",
  "permissions": ["browsingData", "cookies", "scripting", "storage"],
  "host_permissions": [
    "*://intra.42.fr/*",
    "*://profile.intra.42.fr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Effacer les cookies et le cache de l’Intra 42",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
